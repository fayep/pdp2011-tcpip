	.TITLE	ETHIO	RSTS/E Ethernet portal access for PDP-11 C
	.IDENT	/V01.00/
;
; Copyright (c) 2026 Faye Salwin. Licensed CC BY-NC 4.0:
; free for non-commercial use with attribution (see LICENSE).
;
; Thin layer between C and the RSTS/E Ethernet portal interface
; (RSTS/E V10 Programming Manual ch. 7; System Directives Manual 3.27.2;
; driver 170070/xedvr.mac). Assemble with COMMON.MAC as a prefix:
;	MAC> ETHIO,ETHIO=SY:[1,2]COMMON,ETHIO
;
; C calling convention (from CCC/MACRO output): arguments pushed right to
; left, then one word reserved for the result, then CALL. On entry
;	0(SP) return address, 2(SP) result, 4(SP) arg1, 6(SP) arg2 ...
; Every routine saves and restores R0-R5.
;
;	int ethopn(int chan, int unit, int ptype, int nbuf)
;		Open XEunit: on RSTS channel chan as an unpadded portal for
;		protocol type ptype, given as the PDP-11 word of the type
;		field (08-00 -> 0x0008, 08-06 -> 0x0608), with nbuf system
;		receive buffers. Returns 0 or a RSTS error code.
;	int ethcls(int chan)
;	int ethmul(int chan, char *addrs, int count)
;		Enable count (<= 5) multicast addresses (6 bytes each, wire
;		order) on the portal, e.g. FF-FF-FF-FF-FF-FF for broadcasts.
;		Returns 0 or a RSTS error code.
;	int ethget(int chan, char *buf, int size, int wait)
;		Read one frame (dst, src, type, data) into buf. wait != 0
;		stalls until one arrives. Returns the byte count, or minus a
;		RSTS error code (-5: nothing waiting, -13: frames were lost).
;	int ethput(int chan, char *buf, int len)
;		Send buf (dst filled in; src and type are filled in by the
;		driver), 60 <= len <= 1514. Returns 0 or minus an error code.
;	int ethslp(int seconds)		(returns 0; must not be declared void:
;		PDP-11 C reserves the result word only for non-void calls)
;		.SLEEP. The driver ends the sleep early when a frame arrives
;		for one of the job's portals (IOFIN4 clears JS.XE!JSTIM), so
;		"poll every portal without stalling, then sleep" waits on all
;		of them at once, with a timeout.
;	int ethdet(void)
;		Detach this job from its terminal (.UUO UU.DET, closing the
;		terminal channels). Returns 0 or a RSTS error code.
;	A buffer at an odd address is refused with error ODDBUF (ethget and
;	ethput return -ODDBUF): the XE driver uses .READ/.WRITE buffers as
;	given, and an odd one crashes the monitor (odd-address trap in kernel
;	mode). PDP-11 C does not word-align char arrays.
;	int msgdcl(char *name, int maxmsg)
;		.MESAG declare receiver: name (6 characters, space filled)
;		accepting local messages from any job, at most maxmsg queued.
;		A blank name needs no privilege. Returns 0 or a RSTS error.
;	int msgrem(void)
;		.MESAG remove this job's receivers.
;	int msgsnd(char *name, int jobx2, char *params, char *buf, int len)
;		.MESAG send local message: to receiver name (jobx2 = 0), or to
;		job jobx2/2 on its RIB 0 (name = 0). params: 20 bytes copied to
;		the receiver's FIRQB; buf/len: 0..512 data bytes.
;	int msgrcv(char *params, char *buf, int size, int *jobx2)
;		.MESAG receive, no wait. Returns the data byte count and fills
;		params (20 bytes) and *jobx2 (sender's job number * 2), or minus
;		a RSTS error (-5: no message waiting). A pending message also
;		ends ethslp's sleep, so one sleep waits for frames and messages.
;	int tickd(int *w)
;		.DATE: w[0] = minutes until midnight, w[1] = seconds until the
;		next minute, w[2] = ticks until the next second.
;	int fatr(char *name, int *w)
;		Read file name's attributes (UU.ATR) into w[0..10], opening it
;		on channel ATRCH. Returns 0, 1 if the file has none, or minus a
;		RSTS error. RMS words: w[0] record type/attributes, w[1] record
;		size, w[2..3] highest block, w[4..5] end-of-file block (high
;		word first), w[6] first free byte in that block.
;	int fatw(char *name, int *w, int n)
;		Write n (1..11) attribute words to file name. Returns 0 or minus
;		a RSTS error.
;	int fopn(char *name, int chan, unsigned *blocks)
;		Open file name for reading on channel chan with RSTS calls (no
;		RMS: C's stdio cannot open files that carry RMS attributes);
;		*blocks gets its size in blocks. Returns 0 or minus an error.
;	int fblk(int chan, char *buf, unsigned blk)
;		Read block blk (1 = first) into buf (512 bytes, even address).
;		Returns the bytes read, or minus an error (-11: end of file).
;	int fcls(int chan)
;	int fdel(char *name)
;		Delete file name (RSTS call). Returns 0 or minus an error.
;	int dopn(char *name, int chan, int mode)
;		Open device or file name on chan with open MODE mode (0: none).
;		Returns FIRQB+FQSIZM (for a pseudo keyboard: its KB number) or
;		minus an error.
;	int drd(int chan, char *buf, int size, int recmod)
;		.READ with XRB+XRMOD = recmod (RECORD). Returns bytes read or
;		minus an error (-11: nothing there / end of file).
;	int dwr(int chan, char *buf, int len, int recmod)
;		.WRITE with XRB+XRMOD = recmod. Returns the bytes written (with
;		RECORD 8192, no stall, or to a full pseudo keyboard, maybe fewer
;		than len: such an error with data written counts as a partial
;		write) or minus an error.
;	int kbset(int kb, int off, int val)
;		UU.TRM: set one terminal characteristic byte, FIRQB+off = val
;		(e.g. off 012, val 0200: no XON) on KBkb:. Returns 0 or -error.
;	unsigned rpeek(unsigned addr)
;		.PEEK: one word of monitor memory (needs RDMEM).
;	int uutbl(int fn, char *buf)
;		.UUO subfunction fn (UU.TB1 = -3, UU.TB2 = -12: monitor
;		tables); copies the returned FIRQB (32 bytes) to buf.
;		Returns 0 or a RSTS error code.

ETHHND	= 50		; Ethernet device handler index (XRBLKM)
ODDBUF	= 377		; our error code: buffer at an odd address
ATRCH	= 11.		; channel FATR/FATW open files on
SAVSIZ	= 14		; R0-R5 saved on entry: 6 words
RESULT	= SAVSIZ+2	; offsets once the registers are saved
ARG1	= SAVSIZ+4
ARG2	= SAVSIZ+6
ARG3	= SAVSIZ+10
ARG4	= SAVSIZ+12
ARG5	= SAVSIZ+14

	.PSECT	ETHIO,RO,I,GBL,REL,CON

	.MACRO	SAVE
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,-(SP)
	.ENDM
	.MACRO	RESTOR
	MOV	(SP)+,R5
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	.ENDM

; clear the FIRQB (R0, R1 used)
CLRFQ:	MOV	#FIRQB,R0
	MOV	#FQBSIZ/2,R1
10$:	CLR	(R0)+
	SOB	R1,10$
	RETURN

; clear the XRB (R0, R1 used)
CLRXRB:	MOV	#XRB,R0
	MOV	#XRBSIZ/2,R1
10$:	CLR	(R0)+
	SOB	R1,10$
	RETURN

; R0 := error byte from the FIRQB, as a positive word
ERRCOD:	MOVB	@#FIRQB,R0
	BIC	#177400,R0
	RETURN

ETHOPN::
	SAVE
	CALL	CLRFQ
	MOVB	#OPNFQ,@#FIRQB+FQFUN
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#FIRQB+FQFIL	; channel * 2
	MOV	#"XE,@#FIRQB+FQDEV
	MOVB	ARG2(SP),@#FIRQB+FQDEVN
	MOVB	#377,@#FIRQB+FQDEVN+1	; unit number is real
	MOV	#100200,@#FIRQB+FQMODE	; mode given (bit 15) + 128: unpadded
	MOV	ARG4(SP),@#FIRQB+FQCLUS	; system receive buffers
	MOV	ARG3(SP),@#FIRQB+FQNENT	; protocol type
	CALFIP
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

ETHCLS::
	SAVE
	CALL	CLRFQ
	MOVB	#CLSFQ,@#FIRQB+FQFUN
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#FIRQB+FQFIL
	CALFIP
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

ETHMUL::
	SAVE
	MOV	#ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)		; odd buffer: refuse it
	BNE	90$
	CALL	CLRXRB
	MOV	#-3,@#XRB+XRLEN		; enable multicast addresses
	MOV	ARG3(SP),R0
	MUL	#6,R0			; R1 := count * 6
	MOV	R1,@#XRB+XRBC
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	MOVB	#ETHHND,@#XRB+XRBLKM
	.SPEC
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

ETHGET::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)		; odd buffer: refuse it
	BNE	30$
	CALL	CLRXRB
	MOV	ARG3(SP),@#XRB+XRLEN
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	TST	ARG4(SP)
	BEQ	10$
	MOV	#20000,@#XRB+XRMOD	; RECORD 8192: stall until a frame arrives
10$:	.READ
	CALL	ERRCOD
	TST	R0
	BNE	20$
	MOV	@#XRB+XRBC,RESULT(SP)	; bytes read
	BR	30$
20$:	NEG	R0
	MOV	R0,RESULT(SP)
30$:	RESTOR
	RETURN

ETHPUT::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)		; odd buffer: refuse it
	BNE	90$
	CALL	CLRXRB
	MOV	ARG3(SP),@#XRB+XRLEN
	MOV	ARG3(SP),@#XRB+XRBC
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	.WRITE
	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

ETHSLP::
	SAVE
	CALL	CLRXRB
	MOV	ARG1(SP),@#XRB		; seconds
	.SLEEP
	CLR	RESULT(SP)
	RESTOR
	RETURN

ETHDET::
	SAVE
	CALL	CLRFQ
	MOVB	#UU.DET,@#FIRQB+FQFUN
	MOVB	#200,@#FIRQB+FQFIL	; this job; close the terminal channels
	.UUO
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

MSGDCL::
	SAVE
	CALL	CLRFQ
	CALL	CLRXRB
	MOVB	#1,@#FIRQB+FQFIL	; declare receiver
	MOV	ARG1(SP),R0		; name, 6 bytes
	MOV	#FIRQB+FQPPN,R1
	MOV	#6,R2
10$:	MOVB	(R0)+,(R1)+
	SOB	R2,10$
	MOVB	#1,@#FIRQB+FQEXT+1	; access: local senders, no privilege needed
	MOV	#2048.,@#FIRQB+FQSIZ	; buffer maximum
	MOVB	ARG2(SP),@#FIRQB+FQBUFL	; message maximum
	.MESAG
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

MSGREM::
	SAVE
	CALL	CLRFQ
	CALL	CLRXRB
	CLRB	@#FIRQB+FQFIL		; remove receiver
	CLRB	@#FIRQB+FQSIZM		; this job's
	.MESAG
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

MSGSND::
	SAVE
	MOV	#ODDBUF,RESULT(SP)
	BIT	#1,ARG4(SP)		; odd buffer: refuse it
	BNE	90$
	CALL	CLRFQ
	CALL	CLRXRB
	MOVB	#-1,@#FIRQB+FQFIL	; send local data message
	MOVB	ARG2(SP),@#FIRQB+FQSIZM	; job * 2, or 0 to send by name
	MOV	ARG1(SP),R0		; name, or 0
	BEQ	20$
	MOV	#FIRQB+FQPPN,R1
	MOV	#6,R2
10$:	MOVB	(R0)+,(R1)+
	SOB	R2,10$
20$:	MOV	ARG3(SP),R0		; parameters, 20 bytes
	BEQ	40$
	MOV	#FIRQB+FQEXT,R1
	MOV	#20.,R2
30$:	MOVB	(R0)+,(R1)+
	SOB	R2,30$
40$:	MOV	ARG5(SP),@#XRB+XRLEN
	MOV	ARG5(SP),@#XRB+XRBC
	MOV	ARG4(SP),@#XRB+XRLOC
	.MESAG
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

MSGRCV::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)		; odd buffer: refuse it
	BNE	90$
	CALL	CLRFQ
	CALL	CLRXRB
	MOVB	#2,@#FIRQB+FQFIL	; receive, no sleep, any sender, RIB 0
	MOV	ARG3(SP),@#XRB+XRLEN
	MOV	ARG2(SP),@#XRB+XRLOC
	.MESAG
	CALL	ERRCOD
	TST	R0
	BEQ	10$
	NEG	R0
	MOV	R0,RESULT(SP)
	BR	90$
10$:	MOV	#-1,RESULT(SP)		; not a local data message: skip it
	CMPB	@#FIRQB+FQFIL,#-1
	BNE	90$
	MOV	ARG1(SP),R1		; parameters
	BEQ	30$
	MOV	#FIRQB+FQEXT,R0
	MOV	#20.,R2
20$:	MOVB	(R0)+,(R1)+
	SOB	R2,20$
30$:	MOV	ARG4(SP),R1		; sender's job number * 2
	BEQ	40$
	MOVB	@#FIRQB+FQSIZM,R0
	BIC	#177400,R0
	MOV	R0,(R1)
40$:	MOV	@#XRB+XRBC,RESULT(SP)	; data bytes
90$:	RESTOR
	RETURN

TICKD::
	SAVE
	CALL	CLRXRB
	.DATE
	MOV	ARG1(SP),R1
	MOV	@#XRB+XRBC,(R1)+	; minutes until midnight
	MOVB	@#XRB+XRLOC,R0		; seconds until the next minute
	BIC	#177400,R0
	MOV	R0,(R1)+
	MOVB	@#XRB+XRLOC+1,R0	; ticks until the next second
	BIC	#177400,R0
	MOV	R0,(R1)+
	CLR	RESULT(SP)
	RESTOR
	RETURN


; open file name (ARG1, ASCIZ) on channel ATRCH; C clear if it worked,
; else C set and R0 = error (R0-R2 used)
ATROPN:	CALL	CLRFQ			; (these use R0 and R1)
	CALL	CLRXRB
	MOV	ARG1+2(SP),R0		; (one return address deeper)
	MOV	R0,R1
10$:	TSTB	(R1)+			; length of the name
	BNE	10$
	SUB	R0,R1
	DEC	R1
	MOV	R1,@#XRB+XRLEN
	MOV	R1,@#XRB+XRBC
	MOV	ARG1+2(SP),@#XRB+XRLOC
	.FSS				; parse the name into the FIRQB
	TSTB	@#FIRQB
	BNE	20$
	MOVB	#OPNFQ,@#FIRQB+FQFUN
	MOVB	#ATRCH*2,@#FIRQB+FQFIL
	CALFIP
	TSTB	@#FIRQB
	BNE	20$
	CLC
	RETURN
20$:	CALL	ERRCOD
	SEC
	RETURN

ATRCLS:	CALL	CLRFQ
	MOVB	#CLSFQ,@#FIRQB+FQFUN
	MOVB	#ATRCH*2,@#FIRQB+FQFIL
	CALFIP
	RETURN

FATR::
	SAVE
	CALL	ATROPN
	BCS	80$
	CALL	CLRFQ
	MOVB	#UU.ATR,@#FIRQB+FQFUN
	MOVB	#ATRCH,@#FIRQB+FQFIL	; channel; FQSIZM 0 = read
	.UUO
	CALL	ERRCOD
	TST	R0
	BEQ	5$
	NEG	R0			; error: minus the code
	BR	70$
5$:	MOV	#FIRQB+FQPPN,R0		; 11 attribute words
	MOV	ARG2(SP),R1
	MOV	#11.,R2
10$:	MOV	(R0)+,(R1)+
	SOB	R2,10$
	CLR	R0
	MOV	ARG2(SP),R1
	MOV	#11.,R2			; no attributes: all 11 words 0 (not
20$:	TST	(R1)+			; just the first: undefined record
	BNE	70$			; format has record type 0)
	SOB	R2,20$
	INC	R0
70$:	MOV	R0,-(SP)
	CALL	ATRCLS
	MOV	(SP)+,R0
	BR	90$
80$:	NEG	R0
90$:	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

FATW::
	SAVE
	CALL	ATROPN
	BCS	80$
	CALL	CLRFQ
	MOVB	#UU.ATR,@#FIRQB+FQFUN
	MOVB	#ATRCH,@#FIRQB+FQFIL	; channel
	MOVB	ARG3(SP),@#FIRQB+FQSIZM	; words to write
	MOV	ARG2(SP),R0
	MOV	#FIRQB+FQPPN,R1
	MOV	ARG3(SP),R2
10$:	MOV	(R0)+,(R1)+
	SOB	R2,10$
	.UUO
	CALL	ERRCOD
	MOV	R0,-(SP)
	CALL	ATRCLS
	MOV	(SP)+,R0
80$:	NEG	R0
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

FOPN::
	SAVE
	CALL	CLRFQ
	CALL	CLRXRB
	MOV	ARG1(SP),R0
	MOV	R0,R1
10$:	TSTB	(R1)+			; length of the name
	BNE	10$
	SUB	R0,R1
	DEC	R1
	MOV	R1,@#XRB+XRLEN
	MOV	R1,@#XRB+XRBC
	MOV	R0,@#XRB+XRLOC
	.FSS				; parse the name into the FIRQB
	TSTB	@#FIRQB
	BNE	80$
	MOVB	#OPNFQ,@#FIRQB+FQFUN
	MOV	ARG2(SP),R0
	ASL	R0
	MOVB	R0,@#FIRQB+FQFIL	; channel * 2
	CALFIP
	TSTB	@#FIRQB
	BNE	80$
	MOV	ARG3(SP),R1
	BEQ	20$
	MOV	@#FIRQB+FQSIZ,(R1)	; size in blocks
20$:	CLR	RESULT(SP)
	BR	90$
80$:	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

FBLK::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)		; odd buffer: refuse it
	BNE	90$
	CALL	CLRXRB
	MOV	#512.,@#XRB+XRLEN
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	MOV	ARG3(SP),@#XRB+XRBLK	; block number
	.READ
	CALL	ERRCOD
	TST	R0
	BEQ	10$
	NEG	R0
	MOV	R0,RESULT(SP)
	BR	90$
10$:	MOV	@#XRB+XRBC,RESULT(SP)	; bytes read
90$:	RESTOR
	RETURN

FCLS::
	SAVE
	CALL	CLRFQ
	MOVB	#CLSFQ,@#FIRQB+FQFUN
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#FIRQB+FQFIL
	CALFIP
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

FDEL::
	SAVE
	CALL	CLRFQ
	CALL	CLRXRB
	MOV	ARG1(SP),R0
	MOV	R0,R1
10$:	TSTB	(R1)+			; length of the name
	BNE	10$
	SUB	R0,R1
	DEC	R1
	MOV	R1,@#XRB+XRLEN
	MOV	R1,@#XRB+XRBC
	MOV	R0,@#XRB+XRLOC
	.FSS
	TSTB	@#FIRQB
	BNE	80$
	MOVB	#DLNFQ,@#FIRQB+FQFUN	; delete by name
	CALFIP
80$:	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

DOPN::
	SAVE
	CALL	CLRFQ
	CALL	CLRXRB
	MOV	ARG1(SP),R0
	MOV	R0,R1
10$:	TSTB	(R1)+			; length of the name
	BNE	10$
	SUB	R0,R1
	DEC	R1
	MOV	R1,@#XRB+XRLEN
	MOV	R1,@#XRB+XRBC
	MOV	R0,@#XRB+XRLOC
	.FSS
	TSTB	@#FIRQB
	BNE	80$
	MOVB	#OPNFQ,@#FIRQB+FQFUN
	MOV	ARG2(SP),R0
	ASL	R0
	MOVB	R0,@#FIRQB+FQFIL
	MOV	ARG3(SP),R0		; mode, if any
	BEQ	20$
	BIS	#100000,R0		; mode given
	MOV	R0,@#FIRQB+FQMODE
20$:	CALFIP
	TSTB	@#FIRQB
	BNE	80$
	MOVB	@#FIRQB+FQSIZM,R0	; e.g. a pseudo keyboard's KB number
	BIC	#177400,R0
	MOV	R0,RESULT(SP)
	BR	90$
80$:	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

DRD::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)
	BNE	90$
	CALL	CLRXRB
	MOV	ARG3(SP),@#XRB+XRLEN
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	MOV	ARG4(SP),@#XRB+XRMOD
	.READ
	CALL	ERRCOD
	TST	R0
	BEQ	10$
	NEG	R0
	MOV	R0,RESULT(SP)
	BR	90$
10$:	MOV	@#XRB+XRBC,RESULT(SP)
90$:	RESTOR
	RETURN

DWR::
	SAVE
	MOV	#-ODDBUF,RESULT(SP)
	BIT	#1,ARG2(SP)
	BNE	90$
	CALL	CLRXRB
	MOV	ARG3(SP),@#XRB+XRLEN
	MOV	ARG3(SP),@#XRB+XRBC
	MOV	ARG2(SP),@#XRB+XRLOC
	MOV	ARG1(SP),R0
	ASL	R0
	MOVB	R0,@#XRB+XRCI
	MOV	ARG4(SP),@#XRB+XRMOD
	.WRITE
	CALL	ERRCOD
	MOV	ARG3(SP),R1		; written = len - bytes still to go:
	SUB	@#XRB+XRBC,R1		; a pseudo keyboard can take part of
	TST	R0			; the data and then say "no room"
	BEQ	70$
	TST	R1
	BGT	70$			; partly written: report that, not the error
	NEG	R0
	BR	80$
70$:	MOV	R1,R0
80$:	MOV	R0,RESULT(SP)
90$:	RESTOR
	RETURN

KBSET::
	SAVE
	CALL	CLRFQ
	MOVB	#UU.TRM,@#FIRQB+FQFUN
	CLRB	@#FIRQB+FQFIL		; subfunction 0
	MOVB	ARG1(SP),@#FIRQB+FQSIZM	; keyboard number
	MOV	#FIRQB,R0
	ADD	ARG2(SP),R0
	MOVB	ARG3(SP),(R0)		; the one characteristic to change
	.UUO
	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

; int datnow()  - the system date word: (year-1970)*1000 + day of year
DATNOW::
	SAVE
	CALL	CLRXRB
	.DATE
	MOV	@#XRB,RESULT(SP)	; the date (XRB+0)
	RESTOR
	RETURN

; int setdt(int date, int time)  - set the system date and time (.UUO
; UU.DAT, -14.; needs DATES privilege). date: (year-1970)*1000 + day of
; year; time: minutes until midnight (1440 - minutes since midnight); 0
; leaves either alone. The monitor restarts the seconds at the next minute,
; so call it on a minute boundary. 0, or minus a RSTS error code.
UUDAT	= -14.
SETDT::
	SAVE
	CALL	CLRFQ
	MOVB	#UUDAT,@#FIRQB+FQFUN
	MOV	ARG1(SP),@#FIRQB+4
	MOV	ARG2(SP),@#FIRQB+6
	.UUO
	CALL	ERRCOD
	NEG	R0
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

; int getcc(char *buf)  - RSTS core common (low memory 460: a count byte,
; then up to 127 bytes), where a CCL command leaves its whole line, into
; buf with a NUL; its length, or 0. The C runtime gets its arguments from
; the RSX command buffer, which holds only 80 characters.
CORCMN	= 460
GETCC::
	SAVE
	MOV	ARG1(SP),R1
	CLR	RESULT(SP)
	MOVB	@#CORCMN,R2		; length
	BIC	#177400,R2
	BEQ	30$
	CMP	R2,#127.
	BLOS	10$
	MOV	#127.,R2
10$:	MOV	R2,RESULT(SP)
	MOV	#CORCMN+1,R0
20$:	MOVB	(R0)+,(R1)+
	SOB	R2,20$
30$:	CLRB	(R1)
	RESTOR
	RETURN

RPEEK::
	SAVE
	CALL	CLRXRB
	MOV	ARG1(SP),@#XRB		; monitor virtual address
	.PEEK
	MOV	@#XRB,RESULT(SP)	; the word
	RESTOR
	RETURN

UUTBL::
	SAVE
	CALL	CLRFQ
	MOVB	ARG1(SP),@#FIRQB+FQFUN
	.UUO
	MOV	#FIRQB,R0
	MOV	ARG2(SP),R1
	MOV	#FQBSIZ/2,R2
10$:	MOV	(R0)+,(R1)+
	SOB	R2,10$
	CALL	ERRCOD
	MOV	R0,RESULT(SP)
	RESTOR
	RETURN

	.END
